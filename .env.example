# Salin ke .env.local lalu sesuaikan. Jangan commit nilai asli.
DATABASE_URL=postgres://lensa:lensa@127.0.0.1:55432/testlab
APP_URL=http://localhost:3000
PG_POOL_MAX=5

# Penyimpanan bukti di produksi (Vercel Blob). Kosongkan untuk mode lokal.
BLOB_READ_WRITE_TOKEN=
# Set 1 bila bukti wajib privat: fallback URL publik ditolak bila store tidak
# mendukung akses privat (butuh Blob store privat).

# SMTP opsional untuk email reset password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notifikasi Telegram opsional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI runner (scripts/ai-runner.mjs).
AI_RUNNER_TOKEN=
# Opsional: token tambahan per host runner, dipisah koma (tiap token >= 20 karakter).
AI_RUNNER_TOKENS=
# Set 1 pada runner yang memang menguji target internal; tanpa ini host/IP
# privat dan metadata cloud diblokir sebelum memakai model.
AI_RUNNER_ALLOW_PRIVATE_TARGETS=
AI_RUNNER_ID=
# Wajib diisi di produksi: kunci enkripsi kredensial login target per-run.
AI_CREDENTIALS_KEY=
SITESTER_URL=http://localhost:3000
AI_RUN_EMAIL=
AI_RUN_PASSWORD=
AI_TARGET_EMAIL=
AI_TARGET_PASSWORD=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# Model E2E runner (opsional).
E2E_PROVIDER=
E2E_MODEL=
E2E_MODELS=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Database terisolasi untuk Playwright E2E (default bila dikosongkan:
# postgres://lensa:lensa@127.0.0.1:55432/testlab_e2e). Jangan arahkan ke DB dev.
E2E_DATABASE_URL=

# Smoke beban ringan (scripts/load-smoke.mjs).
LOAD_EMAIL=
LOAD_PASSWORD=
CONCURRENCY=
REQUESTS=
P95_BUDGET_MS=
