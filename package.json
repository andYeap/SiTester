{
  "name": "web-tester",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.mjs",
    "test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://lensa:lensa@127.0.0.1:55432/testlab_test} vitest run",
    "test:api": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://lensa:lensa@127.0.0.1:55432/testlab_test} vitest run tests/api",
    "db:cleanup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/cleanup.mjs",
    "test:e2e": "playwright test",
    "preview": "npm run build && next start",
    "test:e2e:ai": "E2E_TELEMETRY_DISABLED=1 NODE_ENV=development e2e run",
    "e2e:list": "E2E_TELEMETRY_DISABLED=1 NODE_ENV=development e2e list",
    "e2e:check-model": "node scripts/check-free-model.mjs",
    "ai-runner": "node scripts/ai-runner.mjs",
    "ai-runner:once": "node scripts/ai-runner.mjs --once"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.4",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai": "^7.0.159",
    "e2e": "^0.22.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
